{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AindriuB/rig-crew/schema/pack.schema.json",
  "title": "rig-crew pack",
  "description": "A role pack has an actor, minRig, workflows, agents, skills, rig and shell. A capability pack has no actor and no workflows.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "minRig": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "requires": { "$ref": "#/$defs/names" },
    "steering": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "load"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "load": { "enum": ["always", "paths", "on-demand"] },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "agents": { "$ref": "#/$defs/names" },
    "skills": { "$ref": "#/$defs/names" },
    "workflows": { "$ref": "#/$defs/names", "minItems": 1 },
    "rig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow", "deny"],
      "properties": {
        "allow": { "$ref": "#/$defs/commands" },
        "deny": { "$ref": "#/$defs/commands" }
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow"],
      "properties": {
        "allow": { "$ref": "#/$defs/commands" }
      }
    }
  },
  "oneOf": [
    {
      "title": "role pack",
      "required": ["actor", "minRig", "workflows", "agents", "skills", "rig", "shell"]
    },
    {
      "title": "capability pack",
      "not": { "anyOf": [{ "required": ["actor"] }, { "required": ["workflows"] }] }
    }
  ],
  "$defs": {
    "names": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "commands": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*( [a-z0-9][a-z0-9-]*)*$" }
    }
  }
}
